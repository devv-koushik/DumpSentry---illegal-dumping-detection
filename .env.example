# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── MongoDB ───
MONGODB_URI=mongodb://127.0.0.1:27017/dumpsentry

# ─── JWT ───
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# ─── Admin seed credentials ───
ADMIN_EMAIL=admin@dumpsentry.ai
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=DumpSentry Admin

# ─── AI Service (Python FastAPI) ───
AI_SERVICE_URL=http://127.0.0.1:8000

# ─── Email (SMTP) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="DumpSentry Alerts <alerts@dumpsentry.ai>"

# ─── Controlled Test Recipient (for placeholder routing & testing) ───
ALERT_TEST_RECIPIENT=controlled-test@dumpsentry.ai

# ─── Frontend URL (for email links) ───
FRONTEND_URL=http://localhost:5173

# ─── Upload limits ───
MAX_FILE_SIZE_MB=25

# ─── Rate limiting ───
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
